# Local environment template — copy to .env.local and fill in your real values.
# DO NOT commit a file that contains a real AIRTABLE_API_KEY.

RPA_ATTACHMENTS_DIR=C:\RPA\SavedAttachments

# Airtable Personal Access Token (https://airtable.com/create/tokens).
# Required scopes: data.records:read, data.records:write, attachment:write
# Leave the placeholder below; replace it ONLY in your local .env.local.
AIRTABLE_API_KEY=pat_REPLACE_WITH_YOUR_TOKEN
AIRTABLE_BASE_ID=appk7XKYQBNBjuE5
AIRTABLE_TABLE_ID=tbletDPR6YDhviL7g

PUBLIC_URL=http://localhost:3000
PORT=3000
